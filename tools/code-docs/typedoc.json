{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Learning Journal Code Reference",
  "plugin": [
    "./component-names.mjs"
  ],
  "entryPoints": [
    "../../src/pages/index.tsx",
    "../../src/pages/imprint/index.tsx"
  ],
  "tsconfig": "../../tsconfig.json",
  "out": "../../static/code-reference",
  "readme": "none",
  "excludeExternals": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": [
    "Function",
    "Interface",
    "Variable"
  ],
  "treatWarningsAsErrors": true
}
